# Copy this file to .env.local (Next.js) or .env and fill in your own values.
# Never commit real keys. .env and .env.* are gitignored, only this example is tracked.

# OpenAI API key used by the app for model calls. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. NVIDIA API key, only if an NVIDIA-hosted model is used. https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# Optional. Set to "replay" to run the main scenario from recorded responses without any API key.
# live   = call the provider; record = call the provider and save responses to fixtures/replay/;
# replay = serve fixtures, never call a provider. Default: live if a key is set, otherwise replay.
DEMO_MODE=

# Which provider to use first: openai (default) or nvidia. The other one is the fallback.
LLM_PROVIDER=openai

# OpenAI-compatible base URL for NVIDIA models. Leave the default unless told otherwise.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Shared secret the Windows Collector sends as "Authorization: Bearer <token>" to /api/ingest/*.
# Any string; empty = ingest endpoints are open (fine for a local run).
INGEST_TOKEN=

# Optional. Upstash Redis for Collector data on Vercel (serverless has no disk).
# Leave both empty to store Collector data as JSON files in ./.data/ (local run).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Same store under the names Vercel's Upstash integration sets automatically; either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional, browser-side. Set to 1 to make the UI use built-in mock AI responses instead of calling /api/ai/*.
NEXT_PUBLIC_MOCK_AI=
